# Copy to .env.local and fill with your own values. Never commit real secrets.

# Supabase — project URL + anon key (Project Settings → API). Leave unset to
# run the app in guest mode with local sample data instead of a real backend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Sentry (error monitoring) — DSN is not secret, safe to expose client-side
VITE_SENTRY_DSN=https://YOUR-KEY@oYOUR-ORG.ingest.us.sentry.io/YOUR-PROJECT-ID
